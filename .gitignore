# --- Do not upload (local / tooling) ---
# .git/ is never pushed as project files; it stays on your machine only.

# Local Git/editor config (kept on disk, not published)
.github/
!.github/
!.github/workflows/
!.github/workflows/pages.yml
.editorconfig
